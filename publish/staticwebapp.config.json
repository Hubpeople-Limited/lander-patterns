{
  "trailingSlash": "never",
  "routes": [
    {
      "route": "/hub-behaviours/v1/*",
      "headers": {
        "cache-control": "public, max-age=3000, stale-while-revalidate=86400",
        "access-control-allow-origin": "*",
        "cross-origin-resource-policy": "cross-origin",
        "x-content-type-options": "nosniff"
      }
    },
    {
      "route": "/hub-behaviours/manifest.json",
      "headers": {
        "cache-control": "public, max-age=3000, stale-while-revalidate=86400",
        "access-control-allow-origin": "*",
        "cross-origin-resource-policy": "cross-origin",
        "x-content-type-options": "nosniff"
      }
    },
    {
      "route": "/hub-behaviours/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable",
        "access-control-allow-origin": "*",
        "cross-origin-resource-policy": "cross-origin",
        "x-content-type-options": "nosniff"
      }
    }
  ],
  "mimeTypes": {
    ".js": "text/javascript",
    ".map": "application/json"
  },
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": [
      "/hub-behaviours/*"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  }
}
